# BSrE Esign API credentials
ESIGN_BASE_URL=https://esign.bssn.go.id
ESIGN_USERNAME=your_username
ESIGN_PASSWORD=your_password

# V1 & V2 signing identity
ESIGN_NIK=3200xxxxxxxxxxxx
ESIGN_EMAIL=user@example.go.id

# V1 requires passphrase, V2 uses passphrase OR TOTP
ESIGN_PASSPHRASE=your_passphrase

# Optional: for visible signing
ESIGN_TTD_IMAGE=../../storage/ttd.png

# Optional: for document download
ESIGN_ID_DOKUMEN=

# Optional: for verify with password-protected PDF
ESIGN_PDF_PASSWORD=